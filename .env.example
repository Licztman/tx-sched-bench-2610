# Solana RPC Configuration (Passed strictly via env/volume, never committed to repo)
HELIUS_API_KEY=your_helius_mainnet_api_key_here
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=

# Optional Signer Keypair for --mode mainnet-live (Mounted read-only or passed via env)
SOLANA_KEYPAIR_PATH=/keys/id.json
SOLANA_KEYPAIR_JSON=
